# MCP Server
ISE_MCP_BASE_URL=http://localhost:8000
ISE_API_KEY=your_indianapi_key_here

# LLM
ANTHROPIC_API_KEY=your_anthropic_key_here
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=2048

# Embeddings
OPENAI_API_KEY=your_openai_key_here
