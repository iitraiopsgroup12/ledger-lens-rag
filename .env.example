# Provider selection: "openai" (default) | "anthropic"
LLM_PROVIDER=openai

# OpenAI — required when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Anthropic — required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_LLM_MODEL=claude-opus-4-8

# Voyage AI (Anthropic-ecosystem embeddings) — required when LLM_PROVIDER=anthropic
VOYAGE_API_KEY=pa-...
ANTHROPIC_EMBEDDING_MODEL=voyage-3

# Google — required when LLM_PROVIDER=google
GOOGLE_API_KEY=AIza...
GOOGLE_LLM_MODEL=gemini-2.0-flash
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004

# HuggingFace — required when LLM_PROVIDER=huggingface
# Embeddings run locally (no API key needed); API key required only for LLM inference
HUGGINGFACE_API_KEY=hf_...
HUGGINGFACE_LLM_MODEL=HuggingFaceH4/zephyr-7b-beta
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Shared — defaults shown
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
FAISS_INDEX_PATH=faiss_index
DEFAULT_TOP_K=4
# Max seconds to wait for an LLM generation before timing out (default 1 hour)
LLM_TIMEOUT=3600
